{
  "name": "discord-ai-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "register": "bun scripts/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/google": "^4.0.118",
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.170",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
